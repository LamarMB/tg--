# Скопируйте этот файл в .env (или просто запустите run_bot.bat — он спросит сам)
BOT_TOKEN=
# Ключ Claude API (console.anthropic.com) — чтобы бот понимал описание проекта текстом
ANTHROPIC_API_KEY=
# Необязательно: модель Claude (по умолчанию claude-sonnet-5)
# CLAUDE_MODEL=claude-sonnet-5
# Необязательно: id пользователей Telegram через запятую, кому можно пользоваться ботом
ALLOWED_USERS=
